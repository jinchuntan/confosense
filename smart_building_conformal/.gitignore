# Virtual environment
.venv/
venv/

# Python caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Raw / intermediate / processed data (regenerated by the pipeline; large)
data/raw/
data/interim/
data/processed/

# Fitted model binaries (regenerated by the pipeline)
outputs/models/*.joblib
outputs/models/*.pt
outputs/full_study/**/models/*.joblib
outputs/full_study/**/models/*.pt

# Regression-check runs: local verification that the preliminary experiment still
# reproduces. Written by redirecting run_experiment's outputs_dir, never reported.
outputs/regression_check/
outputs/regression_check_fast/

# Archived --fast smoke outputs. Kept locally for debugging; superseded by the
# full run and explicitly not dissertation results.
outputs/full_study_smoke/

# Per-observation prediction dumps: ~121 MB of regenerable CSV that would sit in
# git history forever. The metrics, figures, reports and manifests that the
# dissertation actually cites are small and ARE tracked; every prediction file
# can be reproduced from the recorded config hash, seeds and dataset checksums.
# Remove this rule (or `git add -f`) if you deliberately want them versioned.
outputs/full_study/**/predictions/

# OS files
.DS_Store
Thumbs.db

# Reproducibility spot-check runs (verification only, never reported).
outputs/repro_check/
